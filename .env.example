# Copy to .env and fill in your own Snowflake values. Never commit .env.
#
# SNOWFLAKE_ACCOUNT is your account identifier in "<org>-<account>" form. Find it
# in your Snowsight URL: https://app.snowflake.com/<org>/<account>/...
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=MY_USERNAME
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=nfl_wh
SNOWFLAKE_DATABASE=nfl_analytics
SNOWFLAKE_SCHEMA=raw
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Season to ingest. Defaults to 2026 if unset.
NFL_SEASON=2026
